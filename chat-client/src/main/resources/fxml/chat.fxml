<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<SplitPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.chatapp.client.controller.ChatController"
           dividerPositions="0.75" styleClass="chat-container">

    <items>
        <!-- Chat Area -->
        <VBox spacing="10" styleClass="chat-area">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- Chat Target Header -->
            <HBox spacing="10" styleClass="chat-header">
                <Label fx:id="chatTargetLabel" text="Group Chat" styleClass="chat-target-label"/>
                <Button fx:id="backButton" text="← Group Chat" onAction="#handleBackToGroup" styleClass="back-button" managed="false" visible="false"/>
            </HBox>

            <!-- Messages ScrollPane with VBox -->
            <ScrollPane fx:id="messageScrollPane" VBox.vgrow="ALWAYS" styleClass="message-scroll-pane"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                <content>
                    <VBox fx:id="messageContainer" spacing="8" styleClass="message-container"/>
                </content>
            </ScrollPane>

            <!-- Input Area -->
            <HBox spacing="10" styleClass="input-area">
                <Button text="📎" onAction="#handleAttachFile" styleClass="attach-button" prefWidth="40"/>
                <TextField fx:id="messageField" onKeyPressed="#handleKeyPressed"
                           promptText="Type a message..." HBox.hgrow="ALWAYS"/>
                <Button text="Send" onAction="#handleSend" styleClass="send-button" prefWidth="80"/>
            </HBox>
        </VBox>

        <!-- User List Sidebar -->
        <VBox spacing="5" styleClass="sidebar" minWidth="150">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label text="Online Users" styleClass="sidebar-title"/>

            <!-- Click hint -->
            <Label text="(Click to chat)" styleClass="hint-label" />

            <ListView fx:id="userListView" VBox.vgrow="ALWAYS" styleClass="user-list"/>

            <Button text="Logout" onAction="#handleDisconnect" styleClass="disconnect-button"/>
        </VBox>
    </items>
</SplitPane>